<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Characterization tests for SC2MapDocument_Implementation_Plan.md's "Этап 0"
    (record CURRENT behavior before any migration). This project compiles the
    REAL source files directly from the Unity package (via absolute-path
    Compile Include below) rather than copies, so it always tests whatever is
    actually shipped, with zero copy-drift risk.

    Scope: only the genuinely UnityEngine-independent layers (BdfIO.Core,
    BdfIO.Formats, SmartExport, and the plain-text Lua parsing helpers) are
    covered here, because they are the only parts that can run in a bare
    console/test process — everything else (SC2TerrainData being a
    ScriptableObject, scene building, etc.) needs a live Unity Editor/Player
    process and is covered separately by Unity Test Framework EditMode tests
    (see Assets/SC2/Tests/EditMode) instead of duplicated here.

    If dotnet build/test fails with "filename too long", its own
    working/output directory is sitting too deep — copy this whole folder to
    a short path (e.g. C:\Temp\SC2CharTests) and run it from there instead;
    SC2Root below still points back at the real repo's source either way.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Absolute path to Assets/SC2 in the real repo — update if the repo moves. -->
    <SC2Root>C:\Users\user\SupCom2 map editor\Assets\SC2</SC2Root>
    <!-- Only needed for SC2LuaValue.cs's Vector3/Quaternion structs — plain
         value types, usable outside a running Unity process as long as the
         real CoreModule assembly supplies their definition. -->
    <UnityEngineCoreModule>C:\Program Files\Unity\Hub\Editor\6000.0.77f1\Editor\Data\Managed\UnityEngine\UnityEngine.CoreModule.dll</UnityEngineCoreModule>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityEngineCoreModule)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(SC2Root)\Runtime\BdfIO\Core\**\*.cs" LinkBase="Source\BdfIO.Core" />
    <Compile Include="$(SC2Root)\Runtime\BdfIO\Formats\**\*.cs" LinkBase="Source\BdfIO.Formats" />
    <Compile Include="$(SC2Root)\Runtime\SmartExport\**\*.cs" LinkBase="Source\SmartExport" />
    <!-- Vendored KopiLua (Assets/SC2/Runtime/KopiLua/CHANGES_FROM_UPSTREAM.md)
         — pure .NET, no Unity dependency, needed by SC2ScenarioLegacyBridge. -->
    <Compile Include="$(SC2Root)\Runtime\KopiLua\**\*.cs" LinkBase="Source\KopiLua" />
    <!-- Runtime-only model/blueprint parsing foundation for the unit/prop browser.
         Keep it independent of UnityEditor and UnityEngine so it is usable in Player builds. -->
    <Compile Include="$(SC2Root)\Runtime\GameAssets\**\*.cs" LinkBase="Source\GameAssets" />
    <Compile Include="$(SC2Root)\Scripts\GameAssets\SC2ParticleEmitter.cs" Link="Source\SC2ParticleEmitter.cs" />
    <!-- 2026-07-17: SC2TerrainData.cs and its narrow dependency closure
         (SC2LuaBlocks/SC2SaveLuaParser/SC2LuaValue/SC2ShaderFlag/
         SC2TerrainMaterialModel among them) moved from Scripts/ and
         Scripts/TerrainEditor/ into Scripts/Core/ so a Unity EditMode test
         asmdef (SC2.Core.asmdef) could reference them without pulling in
         Assembly-CSharp (which Unity doesn't allow a custom asmdef to
         reference at all). This project still can't compile SC2TerrainData.cs
         itself (ScriptableObject), so it continues to reference just the
         plain-.NET files individually, now from their new path. -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2LuaBlocks.cs" Link="Source\SC2LuaBlocks.cs" />
    <Compile Include="$(SC2Root)\Scripts\Core\SC2SaveLuaParser.cs" Link="Source\SC2SaveLuaParser.cs" />
    <Compile Include="$(SC2Root)\Scripts\Core\SC2LuaValue.cs" Link="Source\SC2LuaValue.cs" />
    <Compile Include="$(SC2Root)\Scripts\Core\SC2Collision2Floor.cs" Link="Source\SC2Collision2Floor.cs" />
    <Compile Include="$(SC2Root)\Scripts\SC2ScdEntryPointResolver.cs" Link="Source\SC2ScdEntryPointResolver.cs" />
    <Compile Include="$(SC2Root)\Scripts\Core\SC2MarkerOrientation.cs" Link="Source\SC2MarkerOrientation.cs" />
    <Compile Include="$(SC2Root)\Scripts\Core\SC2ShaderFlag.cs" Link="Source\SC2ShaderFlag.cs" />
    <Compile Include="$(SC2Root)\Scripts\Core\SC2EnvironmentDefaults.cs" Link="Source\SC2EnvironmentDefaults.cs" />
    <!-- Unified Import Map pipeline: SC2ScdEntryPointResolver's new
         bytecode-aware resolution reuses these two KopiLua-based readers,
         same reasoning as every other file above (plain .NET + KopiLua +
         UnityEngine.Vector3/Quaternion value structs only). -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2LuaBytecodeValue.cs" Link="Source\SC2LuaBytecodeValue.cs" />
    <Compile Include="$(SC2Root)\Scripts\Core\SC2SaveLuaBytecodeReader.cs" Link="Source\SC2SaveLuaBytecodeReader.cs" />
    <!-- SC2Material/SC2MaterialPair/SymmetryMode only: deliberately NOT a
         Scripts\Core\**\*.cs glob, since that folder also contains
         SC2TerrainData.cs itself, which pulls in a ScriptableObject
         dependency tree this project can't compile against (Этап 0's own
         finding). -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2TerrainMaterialModel.cs" Link="Source\SC2TerrainMaterialModel.cs" />
    <!-- Needed by SC2ObjectsLegacyBridge; only Vector3/Quaternion/System
         dependency, same reasoning as SC2LuaValue.cs above. -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2ObjectsModel.cs" Link="Source\SC2ObjectsModel.cs" />
    <Compile Include="$(SC2Root)\Scripts\Core\SC2MarkerDeduplication.cs" Link="Source\SC2MarkerDeduplication.cs" />
    <Compile Include="$(SC2Root)\Scripts\Core\SC2LuaField.cs" Link="Source\SC2LuaField.cs" />
    <!-- Pure symmetry/lobby-spawn math (Vector3 + System only). -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2LobbySpawnMath.cs" Link="Source\SC2LobbySpawnMath.cs" />
    <!-- Vanilla-measured navmesh rules (cross growth, wall ring, water gradient), System only. -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2CostsNavmeshRules.cs" Link="Source\SC2CostsNavmeshRules.cs" />
    <!-- Per-axis UV1 stretch profiles (Mathf/Vector2 only). -->
    <Compile Include="$(SC2Root)\Scripts\TerrainEditor\SC2TerrainUv1Unwrap.cs" Link="Source\SC2TerrainUv1Unwrap.cs" />
    <Compile Include="$(SC2Root)\Scripts\TerrainEditor\SC2WaterFloorSampler.cs" Link="Source\SC2WaterFloorSampler.cs" />
    <!-- Blender-style Flatten area plane (Vector3 / Mathf only). -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2FlattenMath.cs" Link="Source\SC2FlattenMath.cs" />
    <!-- Blend mask editing layers: pure data + compositing math (System only). -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2BlendMaskLayers.cs" Link="Source\SC2BlendMaskLayers.cs" />
    <!-- Pair border outline band for the blend mask (System only). -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2PairOutlineMath.cs" Link="Source\SC2PairOutlineMath.cs" />
    <Compile Include="$(SC2Root)\Scripts\Core\SC2PairOutlineUpdater.cs" Link="Source\SC2PairOutlineUpdater.cs" />
    <!-- Pairs a brush must not touch. -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2PairLockSet.cs" Link="Source\SC2PairLockSet.cs" />
    <!-- Axis-constrained rotate gesture rules. -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2AxisRotation.cs" Link="Source\SC2AxisRotation.cs" />
    <!-- Built-in brush image paths. -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2BrushPresets.cs" Link="Source\SC2BrushPresets.cs" />
    <Compile Include="$(SC2Root)\Scripts\Core\SC2StampGesture.cs" Link="Source\SC2StampGesture.cs" />
    <!-- Distance-based dabs of a custom stamp stroke. -->
    <!-- Which terrain surface (core / background) a brush reaches. -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2SeamReach.cs" Link="Source\SC2SeamReach.cs" />
    <!-- Which object shadows which in the lighting bake. -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2ShadowCasting.cs" Link="Source\SC2ShadowCasting.cs" />
    <!-- Life cycle of the busy plate shown before a long main-thread job. -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2BusyGate.cs" Link="Source\SC2BusyGate.cs" />
    <!-- Sun direction -> where a cube's shadow falls (Environment > Sun preview). -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2SunShadowMath.cs" Link="Source\SC2SunShadowMath.cs" />
    <!-- Point-cloud volume bake (pcloud_up / pcloud_down) and the DXT5 writer for it. -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2PointCloudBaker.cs" Link="Source\SC2PointCloudBaker.cs" />
    <Compile Include="$(SC2Root)\Scripts\SC2DdsEncoder.cs" Link="Source\SC2DdsEncoder.cs" />
    <!-- Cover-and-crop resize of an imported preview picture (Mathf only). -->
    <Compile Include="$(SC2Root)\Scripts\Core\SC2ImageResample.cs" Link="Source\SC2ImageResample.cs" />
    <!-- The per-texel RNM mask rasteriser (TerrainModel/HfieldModel + UnityEngine value types only). -->
    <Compile Include="$(SC2Root)\Scripts\TerrainEditor\SC2RnmMaskBaker.cs" Link="Source\SC2RnmMaskBaker.cs" />
    <!-- SC2MapDocument_Implementation_Plan.md Этап 1 infrastructure. Every
         file under here is either plain .NET or (Session/SC2WorkspaceState.cs)
         only touches UnityEngine.Vector3 — a plain value struct, same
         reasoning as SC2LuaValue.cs above — so the whole layer compiles and
         runs standalone with no further shimming. -->
    <Compile Include="$(SC2Root)\Scripts\MapDocument\**\*.cs" LinkBase="Source\MapDocument" />
    <!-- References the SC2TerrainData ScriptableObject: can't compile
         standalone; see that file's own header comment. -->
    <Compile Remove="$(SC2Root)\Scripts\MapDocument\Domain\Terrain\SC2TerrainLegacyBridge.ScriptableObject.cs" />
    <Compile Remove="$(SC2Root)\Scripts\MapDocument\Domain\Environment\SC2EnvironmentLegacyBridge.ScriptableObject.cs" />
    <Compile Remove="$(SC2Root)\Scripts\MapDocument\Domain\Collision2\SC2CollisionLegacyBridge.ScriptableObject.cs" />
    <Compile Remove="$(SC2Root)\Scripts\MapDocument\Domain\Costs\SC2CostsLegacyBridge.ScriptableObject.cs" />
    <Compile Remove="$(SC2Root)\Scripts\MapDocument\Domain\Hfield\SC2HfieldLegacyBridge.ScriptableObject.cs" />
    <Compile Remove="$(SC2Root)\Scripts\MapDocument\Domain\Objects\SC2ObjectsLegacyBridge.ScriptableObject.cs" />
    <!-- Этап7.S4 (2026-07-19) reverse bridge — same reasoning, references
         SC2TerrainData/Texture2D-resolving SC2TerrainMaterialFactory. -->
    <Compile Remove="$(SC2Root)\Scripts\MapDocument\Domain\SC2MapDocumentToLegacyBridge.ScriptableObject.cs" />
  </ItemGroup>

</Project>
